{
  "datasets": [
    {
      "name": "ds_live_kpi",
      "displayName": "Live KPIs (next 24h)",
      "queryLines": [
        "WITH shows AS (\n",
        "  SELECT st.showtime_id,\n",
        "         a.row_count * a.seats_per_row AS capacity,\n",
        "         count(bs.seat_id) AS sold\n",
        "  FROM movies_app_dev.movies.showtimes st\n",
        "  JOIN movies_app_dev.movies.auditoriums a ON a.auditorium_id = st.auditorium_id\n",
        "  LEFT JOIN movies_app_dev.movies.booking_seats bs ON bs.showtime_id = st.showtime_id\n",
        "  WHERE st.starts_at >= current_timestamp()\n",
        "    AND st.starts_at < current_timestamp() + INTERVAL 24 HOURS\n",
        "  GROUP BY st.showtime_id, a.row_count, a.seats_per_row\n",
        ")\n",
        "SELECT count(*) AS shows_next_24h,\n",
        "       sum(sold) AS seats_sold,\n",
        "       sum(capacity) - sum(sold) AS seats_free,\n",
        "       round(100.0 * sum(sold) / nullif(sum(capacity), 0), 1) AS occupancy_pct\n",
        "FROM shows"
      ]
    },
    {
      "name": "ds_live_by_theater",
      "displayName": "Live occupancy by theater",
      "queryLines": [
        "-- Capacity is per showtime, so it has to be collapsed before the theater\n",
        "-- roll-up: joining booking_seats fans the showtime row out once per seat.\n",
        "WITH shows AS (\n",
        "  SELECT st.showtime_id,\n",
        "         a.theater_id,\n",
        "         max(a.row_count * a.seats_per_row) AS capacity,\n",
        "         count(bs.seat_id) AS sold\n",
        "  FROM movies_app_dev.movies.showtimes st\n",
        "  JOIN movies_app_dev.movies.auditoriums a ON a.auditorium_id = st.auditorium_id\n",
        "  LEFT JOIN movies_app_dev.movies.booking_seats bs ON bs.showtime_id = st.showtime_id\n",
        "  WHERE st.starts_at >= current_timestamp()\n",
        "    AND st.starts_at < current_timestamp() + INTERVAL 24 HOURS\n",
        "  GROUP BY st.showtime_id, a.theater_id\n",
        ")\n",
        "SELECT t.name AS theater,\n",
        "       t.city AS city,\n",
        "       count(*) AS shows,\n",
        "       sum(s.sold) AS seats_sold,\n",
        "       round(100.0 * sum(s.sold) / nullif(sum(s.capacity), 0), 1) AS occupancy_pct\n",
        "FROM shows s\n",
        "JOIN movies_app_dev.movies.theaters t ON t.theater_id = s.theater_id\n",
        "GROUP BY t.name, t.city\n",
        "ORDER BY occupancy_pct DESC"
      ]
    },
    {
      "name": "ds_live_filling",
      "displayName": "Filling up now",
      "queryLines": [
        "SELECT st.starts_at,\n",
        "       m.title AS movie,\n",
        "       t.name AS theater,\n",
        "       a.name AS auditorium,\n",
        "       count(bs.seat_id) AS seats_sold,\n",
        "       max(a.row_count * a.seats_per_row) AS capacity,\n",
        "       round(100.0 * count(bs.seat_id) / max(a.row_count * a.seats_per_row), 1) AS occupancy_pct\n",
        "FROM movies_app_dev.movies.showtimes st\n",
        "JOIN movies_app_dev.movies.movies m ON m.movie_id = st.movie_id\n",
        "JOIN movies_app_dev.movies.auditoriums a ON a.auditorium_id = st.auditorium_id\n",
        "JOIN movies_app_dev.movies.theaters t ON t.theater_id = a.theater_id\n",
        "LEFT JOIN movies_app_dev.movies.booking_seats bs ON bs.showtime_id = st.showtime_id\n",
        "WHERE st.starts_at >= current_timestamp()\n",
        "GROUP BY st.starts_at, m.title, t.name, a.name\n",
        "ORDER BY st.starts_at\n",
        "LIMIT 12"
      ]
    },
    {
      "name": "ds_open_slots",
      "displayName": "Room and slot availability",
      "queryLines": [
        "WITH slots AS (\n",
        "  SELECT * FROM VALUES (11, 'matinee'), (15, 'afternoon'), (19, 'evening'), (22, 'late')\n",
        "  AS s(slot_hour, time_slot)\n",
        "),\n",
        "rooms AS (\n",
        "  SELECT a.auditorium_id, a.name AS auditorium, t.name AS theater, t.city\n",
        "  FROM movies_app_dev.movies.auditoriums a\n",
        "  JOIN movies_app_dev.movies.theaters t ON t.theater_id = a.theater_id\n",
        "),\n",
        "scheduled AS (\n",
        "  SELECT st.auditorium_id, hour(st.starts_at) AS slot_hour, count(*) AS shows\n",
        "  FROM movies_app_dev.movies.showtimes st\n",
        "  WHERE st.starts_at >= current_timestamp()\n",
        "  GROUP BY st.auditorium_id, hour(st.starts_at)\n",
        ")\n",
        "SELECT r.theater, r.city, r.auditorium, s.time_slot,\n",
        "       coalesce(sc.shows, 0) AS shows_next_7d,\n",
        "       CASE WHEN coalesce(sc.shows, 0) = 0 THEN 'FREE' ELSE 'in use' END AS status\n",
        "FROM rooms r\n",
        "CROSS JOIN slots s\n",
        "LEFT JOIN scheduled sc ON sc.auditorium_id = r.auditorium_id AND sc.slot_hour = s.slot_hour\n",
        "ORDER BY status, r.theater, s.slot_hour"
      ]
    },
    {
      "name": "ds_gold_kpi",
      "displayName": "Settled totals",
      "queryLines": [
        "SELECT sum(revenue) AS revenue,\n",
        "       sum(seats_sold) AS seats_sold,\n",
        "       round(100.0 * sum(seats_sold) / nullif(sum(seats_offered), 0), 1) AS occupancy_pct,\n",
        "       sum(sellouts) AS sellouts\n",
        "FROM movies_analytics_dev.movies.demand_by_movie_theater_slot"
      ]
    },
    {
      "name": "ds_demand_rank",
      "displayName": "Demand by movie, theater and slot",
      "queryLines": [
        "SELECT concat(title, ' · ', time_slot) AS movie_slot,\n",
        "       theater_name,\n",
        "       occupancy_pct,\n",
        "       sellout_rate,\n",
        "       showtimes_offered\n",
        "FROM movies_analytics_dev.movies.demand_by_movie_theater_slot\n",
        "WHERE showtimes_offered >= 3\n",
        "ORDER BY occupancy_pct DESC\n",
        "LIMIT 12"
      ]
    },
    {
      "name": "ds_expansion",
      "displayName": "Candidates for more showings",
      "queryLines": [
        "SELECT title, theater_name, city, time_slot,\n",
        "       showtimes_offered, occupancy_pct, sellout_rate, revenue_per_showtime\n",
        "FROM movies_analytics_dev.movies.demand_by_movie_theater_slot\n",
        "WHERE showtimes_offered >= 3 AND occupancy_pct >= 70\n",
        "ORDER BY occupancy_pct DESC"
      ]
    },
    {
      "name": "ds_movie_rank",
      "displayName": "Sell-through by movie",
      "queryLines": [
        "SELECT title,\n",
        "       round(100.0 * sum(seats_sold) / nullif(sum(seats_offered), 0), 1) AS occupancy_pct,\n",
        "       sum(revenue) AS revenue,\n",
        "       sum(showtimes_offered) AS shows\n",
        "FROM movies_analytics_dev.movies.demand_by_movie_theater_slot\n",
        "GROUP BY title\n",
        "ORDER BY occupancy_pct DESC"
      ]
    },
    {
      "name": "ds_revenue_trend",
      "displayName": "Revenue by show date",
      "queryLines": [
        "SELECT show_date, theater_name, revenue, occupancy_pct\n",
        "FROM movies_analytics_dev.movies.revenue_by_day\n",
        "WHERE show_date < current_date()\n",
        "ORDER BY show_date"
      ]
    }
  ],
